{
  "name": "opencloth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WebGPU 服装设计软件",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "vite build --mode site && node scripts/check-site-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "arch:report": "node scripts/check-architecture.mjs",
    "arch:check": "node scripts/check-architecture.mjs --check && node scripts/check-style.mjs --check",
    "style:report": "node scripts/check-style.mjs",
    "style:check": "node scripts/check-style.mjs --check"
  },
  "dependencies": {
    "oidn-webgpu": "^0.6.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.18",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
